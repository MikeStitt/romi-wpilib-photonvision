// Generated by book-em-danno (danno config generate) from danno.toml. Edit danno.toml.
// models.<tag>.limit.context : OpenCode's CLIENT-SIDE belief of the window, used to
//                              trim/compact the conversation. From danno's context_budget.
//                              It does NOT set Ollama's real window: under /v1 Ollama
//                              loads the model at its FULL context (a body num_ctx is
//                              ignored). The real window / RAM lever is an Ollama
//                              Modelfile variant, not an opencode.jsonc key.
// models.<tag>.limit.output  : tokens OpenCode reserves for the reply
//                              (usable input is roughly context - output).
// models.<tag>.options.reasoningEffort : forwarded raw into the /v1 request body where
//                              Ollama honors it. 'none' disables the thinking trace
//                              (faster; avoids the opencode #21903 reasoning-field hang).
// opencode ALWAYS streams (stream:true is hardcoded); there is no stream/thinking key.
// Local agents need a TOOL-CAPABLE model (gemma3:1b cannot tool-call).
{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "model": "nvidia/nvidia/nemotron-3-ultra-550b-a55b",
  "small_model": "nvidia/nvidia/nemotron-3-ultra-550b-a55b",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ollama (local)",
      "options": {
        "baseURL": "http://host.docker.internal:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "gemma3:27b": {
          "name": "gemma3:27b (local)",
          "tool_call": false,
          "limit": {
            "context": 128000,
            "output": 8192
          },
          "options": {
            "reasoningEffort": "none"
          }
        },
        "gpt-oss:20b": {
          "name": "gpt-oss:20b (local)",
          "tool_call": true,
          "limit": {
            "context": 128000,
            "output": 8192
          },
          "options": {
            "reasoningEffort": "none"
          }
        },
        "qwen3-coder-next": {
          "name": "qwen3-coder-next (local)",
          "tool_call": true,
          "limit": {
            "context": 128000,
            "output": 8192
          },
          "options": {
            "reasoningEffort": "none"
          }
        },
        "qwen3.6:27b-q4_K_M": {
          "name": "qwen3.6:27b-q4_K_M (local)",
          "tool_call": true,
          "limit": {
            "context": 128000,
            "output": 8192
          },
          "options": {
            "reasoningEffort": "medium"
          }
        }
      }
    },
    "nvidia": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "nvidia",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "apiKey": "{env:NVIDIA_API_KEY}"
      },
      "models": {
        "nvidia/nemotron-3-ultra-550b-a55b": {
          "name": "nvidia/nemotron-3-ultra-550b-a55b",
          "tool_call": true,
          "limit": {
            "context": 1000000,
            "output": 8192
          }
        }
      }
    }
  },
  "agent": {
    "plan": {
      "model": "nvidia/nvidia/nemotron-3-ultra-550b-a55b"
    },
    "build": {
      "model": "nvidia/nvidia/nemotron-3-ultra-550b-a55b"
    },
    "architect": {
      "model": "nvidia/nvidia/nemotron-3-ultra-550b-a55b"
    },
    "reviewer": {
      "model": "nvidia/nvidia/nemotron-3-ultra-550b-a55b"
    },
    "pm": {
      "model": "nvidia/nvidia/nemotron-3-ultra-550b-a55b"
    },
    "coder": {
      "model": "nvidia/nvidia/nemotron-3-ultra-550b-a55b"
    },
    "committer": {
      "model": "nvidia/nvidia/nemotron-3-ultra-550b-a55b"
    },
    "runner": {
      "model": "nvidia/nvidia/nemotron-3-ultra-550b-a55b"
    },
    "external-researcher": {
      "model": "nvidia/nvidia/nemotron-3-ultra-550b-a55b"
    }
  },
  "plugin": [
    [
      "@plannotator/opencode@latest",
      {
        "workflow": "plan-agent",
        "planningAgents": [
          "plan"
        ]
      }
    ]
  ]
}
